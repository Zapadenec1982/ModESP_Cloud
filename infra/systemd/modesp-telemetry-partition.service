[Unit]
Description=Ensure telemetry partitions for the next 6 months
After=postgresql.service
Wants=postgresql.service
OnFailure=modesp-alert@%n.service

[Service]
Type=oneshot
# Runs as the app user with the DB_USER credentials from backend/.env:
# create_telemetry_partition() is SECURITY DEFINER since migration 023, so the
# schema owner is no longer needed here.
User=modesp
Group=modesp
WorkingDirectory=/opt/modesp-cloud/backend
ExecStart=/usr/bin/node src/scripts/ensure-partitions.js

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=modesp-telemetry-partition

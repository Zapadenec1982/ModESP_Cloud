# ModESP Cloud — backup configuration, read by modesp-backup.service.
# Copy to /opt/modesp-cloud/infra/backup.env (owner root, chmod 600).
# Every variable is optional; the value shown is the default.

# Local archive directory. The `last-success` marker is written here too.
#BACKUP_DIR=/var/backups/modesp

# Retention in days: local archives, then the off-site copies.
#BACKUP_RETENTION_DAYS=14
#BACKUP_REMOTE_RETENTION_DAYS=30

# Encrypt every archive with a symmetric GPG key (AES-256).
# Keep this passphrase somewhere OTHER than this server: without it the
# off-site copies cannot be restored.
#BACKUP_PASSPHRASE=

# Off-site copy: any rsync-over-ssh destination, e.g. a Hetzner Storage Box.
# The remote directory must already exist. Old remote archives are pruned over
# SFTP by the date in their file name, so the destination must offer SFTP
# (Storage Box does). Run the copy once by hand as root to accept the host key.
#BACKUP_REMOTE=u123456@u123456.your-storagebox.de:modesp/

# Extra `-o` options for ssh/sftp (port, key file). Alternatively describe the
# host in /root/.ssh/config and leave this empty.
#BACKUP_SSH_OPTS=-o Port=23 -o IdentityFile=/root/.ssh/modesp_backup

# Database. By default pg_dump/pg_dumpall run as the postgres OS user over the
# local socket (peer auth, no password). Set the variables below only for a
# database on another host.
#BACKUP_DB_NAME=modesp_cloud
#BACKUP_PG_OS_USER=postgres
#BACKUP_DB_HOST=
#BACKUP_DB_PORT=5432
#BACKUP_DB_USER=
#BACKUP_DB_PASSWORD=

# Additional absolute paths for files.tar.gz, space-separated.
#BACKUP_EXTRA_PATHS=

# OS group allowed to read the last-success marker (the backend reports backup
# age from it in /api/health).
#BACKUP_GROUP=modesp

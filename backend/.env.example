NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modesp_cloud
DB_USER=modesp_cloud
DB_PASS=

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USER=modesp_backend
MQTT_PASS=

# Auth (Phase 4) — set AUTH_ENABLED=true to require JWT
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# Push Notifications (Phase 3)
# Telegram bot — get token from @BotFather
TELEGRAM_BOT_TOKEN=
# FCM — path to Firebase service account JSON file
FCM_SERVICE_ACCOUNT_PATH=

# MQTT Dynamic Auth (Phase 4)
# Bootstrap password shared across all ESP32 at flash time
MQTT_BOOTSTRAP_PASSWORD=
# Public hostname for devices (shown in WebUI for manual entry)
MQTT_PUBLIC_HOST=
# Minutes(ms) an active device must be offline before the shared bootstrap key
# may reset it to pending (factory-reset recovery). Blocks replayed-key abuse of
# live devices. Default 600000 (10 min).
RESET_OFFLINE_GRACE_MS=

# Email (Resend) — get API key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=alerts@modesp.com.ua
EMAIL_APP_URL=https://modesp.com.ua

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@modesp.com.ua

# CORS (dev: Vite devserver)
CORS_ORIGIN=http://localhost:5173

# OTA (Phase 6)
# Origin only (no path) — signed download path is appended automatically
FIRMWARE_BASE_URL=http://localhost:3000
FIRMWARE_STORAGE_PATH=./firmware
OTA_TIMEOUT_MS=600000
# Dedicated secret for signing firmware download URLs (HMAC). Falls back to
# JWT_SECRET if unset, but a separate secret is recommended (key hygiene).
FIRMWARE_URL_SECRET=

# Tuning
# Telemetry sampling. 300000 (5 min) is the production default and the basis of
# the storage estimates in docs/DATABASE.md; 60000 (1 min) multiplies storage
# by five and is reserved for plans that include minute-level sampling.
TELEMETRY_INTERVAL_MS=300000
OFFLINE_THRESHOLD_MS=90000
STATE_DEBOUNCE_MS=30000
REGISTRY_REFRESH_MS=60000

# Nuisance alarm delays (ISA-18.2). An alarm that clears within the delay is never
# recorded and never notified. Raise the door delay if goods deliveries at a site
# hold the door open longer than this and are being reported as alarms.
DOOR_ALARM_DELAY_MS=600000
PULLDOWN_ALARM_DELAY_MS=300000

# =====================================================================
#  THIRD-PARTY SERVICES — DEMO CONFIGURATION
#
#  These defaults are tuned for a DEMO / pre-production deployment.
#
#  !! BEFORE GOING TO PRODUCTION !!
#  Open-Meteo, the OSRM demo server and OpenRouteService are all free for
#  non-commercial use ONLY. ModESP Cloud is a commercial product, so each
#  one needs a paid plan or a self-hosted instance before production.
#  See docs/THIRD_PARTY_LICENSING.md for the checklist.
# =====================================================================
# Every *_TIMEOUT_MS below must stay under nginx's `proxy_read_timeout 30s`
# on `location /api/` — a longer upstream wait becomes a 504 in the browser
# instead of the graceful degradation each service is written to provide.

# -- Geocoding (Nominatim) --
# OSM usage policy: max 1 req/s, identifying User-Agent, no bulk geocoding.
# GEOCODER_PROVIDER=none (or empty) disables geocoding entirely.
GEOCODER_PROVIDER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org
# REPLACE BOTH before you point this at the public Nominatim instance. Its usage
# policy requires a real, MONITORED contact address — a default or invented one is
# itself grounds for a block, and geocode.js puts GEOCODER_EMAIL in the `email=`
# query parameter of every upstream request, so it lands in the provider's logs.
# docs/DEPLOYMENT.md carries the same placeholder.
GEOCODER_USER_AGENT=ModESP-Cloud/1.0 (admin@your-domain.tld)
GEOCODER_EMAIL=admin@your-domain.tld
GEOCODER_RATE_LIMIT_MS=1100
GEOCODER_CACHE_TTL_DAYS=180
GEOCODER_TIMEOUT_MS=8000
# Negative results (provider answered, no match) expire in hours, not months —
# otherwise one bad address stays un-geocodable for the whole positive TTL.
GEOCODER_NEGATIVE_TTL_MIN=360
# The OSM policy bars systematic/bulk querying regardless of pacing. Leave
# false unless GEOCODER_URL points at a self-hosted Nominatim instance.
GEOCODER_BULK_ENABLED=false

# -- Outdoor weather (Open-Meteo) --
# NOTE: the free Open-Meteo API is for NON-COMMERCIAL use. A commercial ModESP
# deployment needs a paid plan or a self-hosted instance. Empty = feature disabled.
WEATHER_PROVIDER=open-meteo          # was empty; enabled for the demo
WEATHER_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_MIN=30
WEATHER_POLL_INTERVAL_MIN=60
WEATHER_TIMEOUT_MS=8000
# Retention sweep for weather_observations (backend/scripts/cleanup-weather.js,
# run daily by modesp-retention-cleanup.timer). 395 days keeps year-over-year
# comparison working. The other retention settings live in the block below.
WEATHER_RETENTION_DAYS=395

# -- Routing / service-round optimisation (OSRM) --
# The public OSRM demo server is NOT for production use -- self-host.
# Empty = route optimisation disabled; stop ordering and the Google Maps deep
# link still work, the UI just labels them "orientation only".
OSRM_URL=https://router.project-osrm.org   # DEMO SERVER: rate-limited, no SLA,
                                           # explicitly not for production — self-host before prod
OSRM_TIMEOUT_MS=10000

# -- Isochrones (OpenRouteService) --
# Empty API key = isochrones fall back to straight-line distance rings, which the
# UI must visibly label as approximate.
#
# DEPRECATION: ORS is moving off api.openrouteservice.org to api.heigit.org. As of
# 2026-08-23 the old host still answers (401 without a key) and the new one 404s on
# every /v2 path, so the old host stays. Re-check before production and switch when
# the new host actually serves the API.
ORS_URL=https://api.openrouteservice.org
ORS_API_KEY=                         # stays empty: needs a key. Without it isochrones
                                     # fall back to approximate straight-line rings.
ORS_TIMEOUT_MS=10000
# ORS meters per ACCOUNT, not per user: the free plan allows 20 isochrone requests
# a minute and 500 a day, while our per-user express limiter allows 30/min. One
# process-wide pacer keeps us under the account ceiling however many people are on
# the map. Set to 0 to disable it — correct only for a self-hosted ORS, which has
# no account quota.
ORS_MIN_INTERVAL_MS=3500

# -- Data retention (systemd timers, see docs/DEPLOYMENT.md "Таймери") --
# Telemetry partitions older than this are dropped monthly by
# modesp-telemetry-cleanup.timer (backend/scripts/cleanup-telemetry.js --apply).
# drop_telemetry_partition() refuses anything younger than 7 days regardless.
TELEMETRY_RETENTION_DAYS=90
# Row sweeps run daily by modesp-retention-cleanup.timer
# (backend/scripts/cleanup-aux.js --apply). 0 disables the individual sweep.
EVENT_RETENTION_DAYS=365
NOTIFICATION_LOG_RETENTION_DAYS=90
# Inactive (cleared) alarms only; active alarms are never swept.
ALARM_RETENTION_DAYS=365
# How many months ahead ensure-partitions.js creates telemetry partitions.
PARTITION_MONTHS_AHEAD=6

# -- Platform monitoring (docs/DEPLOYMENT.md "Моніторинг") --
# Telegram group that receives platform alerts from modesp-alert@.service (a
# failed backup/cleanup/partition run, a backend crash loop). Uses the alarm bot
# (TELEGRAM_BOT_TOKEN): add the bot to the group and put the group's chat id here.
PLATFORM_ALERT_CHAT_ID=
# Where modesp-backup.service writes its last-success marker; GET /api/health
# reports platform=attention once it is older than BACKUP_MAX_AGE_HOURS or the
# filesystem holding FIRMWARE_STORAGE_PATH has less than DISK_MIN_FREE_PCT free.
BACKUP_DIR=/var/backups/modesp
BACKUP_MAX_AGE_HOURS=48
DISK_MIN_FREE_PCT=10

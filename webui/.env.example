# ─────────────────────────────────────────────────────────────────────────────
#  ModESP Cloud — Web UI build-time configuration
#
#  Vite only exposes variables prefixed with VITE_ to the browser bundle, and it
#  inlines them at BUILD time — changing a value here requires a rebuild, not a
#  restart. Never put a secret in this file: everything below ships to the client.
#
#  Copy to `webui/.env` (git-ignored) and edit as needed. Every value has a
#  working default in `webui/src/lib/geo.js`, so an empty/absent .env is fine.
# ─────────────────────────────────────────────────────────────────────────────

# -- Map raster tiles --
# The ONLY external host the browser talks to. Nominatim, Open-Meteo, OSRM and
# OpenRouteService are all called server-side; the Google/Apple/Waze/OSM route
# links are navigations, which CSP does not gate.
#
# !! Changing the tile host also requires updating `img-src` in
# !! backend/src/index.js (helmet) AND in BOTH Content-Security-Policy headers in
# !! infra/nginx/modesp.conf — otherwise every tile is blocked and the map is grey.
#
# The public OpenStreetMap tile server has a usage policy and is not suitable for
# a commercial deployment at scale — see docs/THIRD_PARTY_LICENSING.md.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Attribution shown in the map corner. OpenStreetMap data attribution is a
# licence obligation — do not remove it when switching providers, add to it.
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors

# -- Platform status page --
# Public status page of the external uptime monitor (UptimeRobot / Better Stack).
# When set, the sidebar footer shows a "Platform status" link; empty hides it.
VITE_STATUS_PAGE_URL=
